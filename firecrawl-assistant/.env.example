# ── Firecrawl ─────────────────────────────────────────────
# Cloud API key from https://firecrawl.dev (starts with fc-). Required for the hosted API.
FIRECRAWL_API_KEY=fc-your-key-here
# Leave empty for the hosted API. Set to your own instance (e.g. http://localhost:3002) when self-hosting.
FIRECRAWL_API_URL=

# ── This service ──────────────────────────────────────────
# Shared secret callers must send as "Authorization: Bearer <key>" or "x-api-key: <key>".
# REQUIRED when NODE_ENV=production: every call here spends Firecrawl credits.
SERVICE_API_KEY=change-me-to-a-long-random-string
PORT=3000

# ── Safety limits (all optional; defaults shown) ──────────
# Comma-separated. If ALLOWED_DOMAINS is set, only these hosts (and their subdomains) can be fetched.
ALLOWED_DOMAINS=
# Always refused, even if allowed above.
BLOCKED_DOMAINS=
MAX_SEARCH_RESULTS=5
MAX_CRAWL_PAGES=10
MAX_MAP_LINKS=100
# Per-request budget for search / scrape / map (ms)
REQUEST_TIMEOUT_MS=60000
# How long POST /v1/crawl and /v1/agent wait before answering 202 + job id (seconds)
CRAWL_WAIT_SECONDS=45
AGENT_WAIT_SECONDS=45
# Upper bound sent to Firecrawl as maxCredits for each agent run (your own spend cap; tune to your plan)
AGENT_MAX_CREDITS=100
# Requests per minute per caller (in-memory; see README for serverless caveat)
RATE_LIMIT_PER_MINUTE=30

# ─────────────────────────────────────────────────────────────
# Ariana — environment template. Copy names into Render → Environment.
# Never commit real values. Blank = not set.
# ─────────────────────────────────────────────────────────────

# ── CORE (required) ──────────────────────────────────────────
GROQ_API_KEY=                     # her brain (Groq, Llama 3.3 70B)
SUPABASE_URL=                     # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # server-only; sessions, memory, settings live here
DASHBOARD_SECRET=                 # locks the dashboard + owner commands (if unset, the dashboard is OPEN)
OWNER_PHONE=                      # your own number, country code, digits only
RENDER_URL=                       # https://<your-service>.onrender.com  (keep-alive self-ping)
BASE_URL=                         # same as RENDER_URL

# ── WHATSAPP TEXT (whatsapp-web.js sidecar) ──────────────────
WA_PROVIDER=wwebjs                # wwebjs (default) | kapso
PHONE_NUMBER=                     # Ariana's WhatsApp number, country code, digits only → pairing code
WA_ADMIN_KEY=                     # protects /wa linking pages: open /wa?key=<this>
# WA_PROXY=                       # optional http://user:pass@host:port for Chromium; leave unset first
# KAPSO_API_KEY=                  # only if WA_PROVIDER=kapso
# KAPSO_PHONE_NUMBER_ID=

# ── TELEGRAM ─────────────────────────────────────────────────
TELEGRAM_API_ID=                  # from my.telegram.org
TELEGRAM_API_HASH=
TELEGRAM_SESSION=                 # string session (until dashboard pairing replaces this)

# ── SIGNAL (needs a separate signal-cli-rest-api service) ────
SIGNAL_CLI_URL=
SIGNAL_NUMBER=

# ── VOICE / VISION ───────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
GEMINI_API_KEY=                   # image understanding

# ── WEB SKILLS (optional) ────────────────────────────────────
SERPER_API_KEY=
BROWSER_USE_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── PUSH NOTIFICATIONS ───────────────────────────────────────
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_EMAIL=                      # must look like: mailto:you@example.com  (no spaces, no <>)

# ── PAYMENTS / WALLETS (optional) ────────────────────────────
# WALLET_* addresses

# ── INFLUENCER / SOCIAL LAYER (optional, separate service) ───
SOCIAL_ENGINE_URL=
SOCIAL_ENGINE_API_KEY=

# ── WACALLS (calls). Leave disabled until the WaCalls server + audio bridge exist ──
WACALLS_ENABLED=false
WACALLS_URL=http://127.0.0.1:8080
WACALLS_SESSION_ID=ariana
WACALLS_API_KEY=
WACALLS_CLIENT_ID=ariana-ai
WACALLS_AUTO_ANSWER=true
WACALLS_ADAPTER_PORT=3002
WACALLS_WEBHOOK_SECRET=           # REQUIRED for any call to /integrations/wacalls/* from outside the container
# Only for a chat-capable WaCalls fork (upstream WaCalls has NO text API):
# WACALLS_MESSAGE_PATH=/api/sessions/ariana/messages

# Existing Ariana app
PORT=3000
GROQ_API_KEY=
WHATSAPP_NUMBER=15551234567

# Existing whatsapp-web.js remains enabled and unchanged
WA_PROVIDER=wwebjs
PHONE_NUMBER=15551234567
WA_WEB_PORT=3001

# WaCalls parallel integration
WACALLS_ENABLED=false
WACALLS_URL=http://127.0.0.1:8080
WACALLS_SESSION_ID=ariana
WACALLS_API_KEY=
WACALLS_CLIENT_ID=ariana-ai
WACALLS_AUTO_ANSWER=true
WACALLS_ADAPTER_PORT=3002
# Required if callback routes are exposed outside localhost
WACALLS_WEBHOOK_SECRET=
# Only needed with a chat-capable WaCalls fork; this is its conventional route
WACALLS_MESSAGE_PATH=/api/sessions/ariana/messages

# Voice pipeline used for call responses (Cartesia first, ElevenLabs fallback)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

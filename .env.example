# ─────────────────────────────────────────────────────────────
# Ariana — environment template. Copy names into Render → Environment.
# Never commit real values. Blank = not set.
# ─────────────────────────────────────────────────────────────

# ── CORE (required) ──────────────────────────────────────────
GROQ_API_KEY=                     # her brain (Groq, Llama 3.3 70B)
SUPABASE_URL=                     # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # server-only; sessions, memory, settings live here
DASHBOARD_SECRET=                 # locks the dashboard + owner commands (if unset, the dashboard is OPEN)
OWNER_PHONE=                      # your number, DIGITS ONLY, no + (WhatsApp senders arrive as digits), e.g. 2349077848577
RENDER_URL=                       # https://<your-service>.onrender.com  (keep-alive self-ping)
BASE_URL=                         # same as RENDER_URL

# ── WHATSAPP TEXT (whatsapp-web.js sidecar, runs on Fly.io) ──
# Same WA_API_SECRET + WA_ADMIN_KEY must be set on BOTH Render and Fly.
WA_PROVIDER=wwebjs                # wwebjs (default) | kapso
WA_WEB_URL=                       # Render only: https://<fly-app>.fly.dev
WA_API_SECRET=                    # long random string, shared Render <-> Fly (authenticates both directions)
WA_ADMIN_KEY=                     # long random string; linking page: https://<fly-app>.fly.dev/?key=<this>
# Fly only:
MAIN_APP_URL=                     # https://<your-render-service>.onrender.com
PHONE_NUMBER=                     # Ariana's WhatsApp number, country code, digits only → pairing code
# WA_PROXY=                       # optional http://user:pass@host:port for Chromium; leave unset first
# KAPSO_API_KEY=                  # only if WA_PROVIDER=kapso
# KAPSO_PHONE_NUMBER_ID=

# ── TELEGRAM ─────────────────────────────────────────────────
TELEGRAM_API_ID=                  # from my.telegram.org
TELEGRAM_API_HASH=
TELEGRAM_SESSION=                 # string session (until dashboard pairing replaces this)

# ── SIGNAL (needs a separate signal-cli-rest-api service) ────
SIGNAL_CLI_URL=
SIGNAL_NUMBER=

# ── NIGERIAN VOICE (Pidgin + Yoruba) — WazobiaVoice service, see wazobia-service/ ──
# Runs on a GPU host (not Render). Leave blank to keep English-only voice.
WAZOBIA_TTS_URL=…
WAZOBIA_TTS_KEY=…
# WAZOBIA_TTS_TIMEOUT_MS=90000

# ── VOICE / VISION ───────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
GEMINI_API_KEY=                   # image understanding

# ── WEB SKILLS (optional) ────────────────────────────────────
SERPER_API_KEY=
BROWSER_USE_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── PUSH NOTIFICATIONS ───────────────────────────────────────
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_EMAIL=                      # must look like: mailto:you@example.com  (no spaces, no <>)

# ── PAYMENTS / WALLETS (optional) ────────────────────────────
# WALLET_* addresses

# ── INFLUENCER / SOCIAL LAYER (optional, separate service) ───
SOCIAL_ENGINE_URL=
SOCIAL_ENGINE_API_KEY=

# X (Twitter) through the official API — a separate, sleep-when-idle service (x-service/).
# Nothing polls it: it is contacted only when Ariana uses an X tool or you press Connect.
# Both are required; the key must be the same value as X_SERVICE_API_KEY on the service.
X_SERVICE_URL=                    # e.g. https://ariana-x.onrender.com
X_SERVICE_API_KEY=
# X_SERVICE_WAKE_MS=150000        # how long to wait for a sleeping service to come up
# X_SERVICE_CALL_MS=60000         # how long to wait for one X action to answer

# ── WACALLS (calls). Leave disabled until the WaCalls server + audio bridge exist ──
WACALLS_ENABLED=false
WACALLS_URL=http://127.0.0.1:8080
WACALLS_SESSION_ID=ariana
WACALLS_API_KEY=
WACALLS_CLIENT_ID=ariana-ai
WACALLS_AUTO_ANSWER=true
WACALLS_ADAPTER_PORT=3002
WACALLS_WEBHOOK_SECRET=           # REQUIRED for any call to /integrations/wacalls/* from outside the container
# Only for a chat-capable WaCalls fork (upstream WaCalls has NO text API):
# WACALLS_MESSAGE_PATH=/api/sessions/ariana/messages

# ── WhatsApp media understanding (all optional; sensible defaults) ──
# Voice notes are transcribed with OPENAI_API_KEY (falls back to GROQ_API_KEY if set). Luna still writes the reply.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe   # any OpenAI speech-to-text model your key can use (e.g. whisper-1)
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# MEDIA_MAX_FRAMES=6            # frames sampled from GIFs / animated stickers (cost cap)
# MEDIA_FRAME_PX=512            # longest side of each sampled frame
# MEDIA_MAX_ANIM_SECONDS=12     # only the first N seconds of a video/GIF are sampled
# MEDIA_MAX_AUDIO_SECONDS=180   # longer voice notes are refused honestly
# OPENAI_BASE_URL=              # tests / proxies only
# HUMAN_DELAY_SCALE=1           # 0 disables the human-like reply delay (tests)

# ── Web search / page reading for Ariana (Firecrawl) ──
# Set FIRECRAWL_API_KEY on Render (https://firecrawl.dev). Without it she simply isn't offered the web tools.
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_API_URL=                 # only for a self-hosted Firecrawl
# FIRECRAWL_ALLOWED_DOMAINS=         # optional comma list; if set, only these hosts can be read
# FIRECRAWL_BLOCKED_DOMAINS=
# FIRECRAWL_DAILY_CAP=150            # max Firecrawl calls per day
# FIRECRAWL_SEARCH_CONTENT=1         # 0 = titles/snippets only (cheaper)
